MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
PORT=5000
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
CONTACT_RECEIVER_EMAIL=where-messages-should-arrive@example.com
BLOG_ADMIN_TOKEN=choose-a-long-random-string

# Admin panel (/admin). Generate the hash with:  npm run hash-password -- "your password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=choose-a-long-random-string

# Frontend origins allowed to call the API, comma-separated (leave empty to allow all)
ALLOWED_ORIGINS=
