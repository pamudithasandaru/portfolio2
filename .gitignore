# Root ignore rules for portfolio monorepo

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Builds and coverage
client/build/
client/coverage/
server/coverage/

# Environment files
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example
server/.env
server/.env.*
!server/.env.example

# Logs and runtime files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.pid

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.swp
